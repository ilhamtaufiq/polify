---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Objek JSON-LD tambahan untuk halaman ini (opsional). */
  jsonLd?: Record<string, unknown>[];
  /** Gambar untuk preview tautan (og:image), path relatif terhadap situs. */
  image?: string;
  imageAlt?: string;
}

const { title, description, jsonLd = [], image = "/og-image.png", imageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const siteName = "Polify";
const alt = imageAlt ?? "Polify: pembuat ZIP SHP polygon untuk OSS RBA dan Amdalnet";
const year = new Date().getFullYear();

const baseLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteName,
    url: Astro.site?.toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: Astro.site?.toString(),
  },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={alt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {[...baseLd, ...jsonLd].map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Polify, beranda">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="9" fill="var(--brand)" />
          <path d="M7 22 L12 9 L24 11 L25 22 Z" fill="none" stroke="var(--brand-ink)" stroke-width="2.4" stroke-linejoin="round" />
          <circle cx="12" cy="9" r="2" fill="var(--accent)" />
        </svg>
        <span>Polify</span>
        <small>Cianjur</small>
      </a>
      <nav aria-label="Utama">
        <a href="/layanan">Layanan</a>
        <a href="/impor">Impor & cek</a>
        <a href="/editor" class="nav-cta">Buat SHP</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <p><strong>Polify</strong>: batas lahan jadi ZIP SHP untuk OSS RBA dan Amdalnet.</p>
          <p class="footer-note">
            Polify tidak berafiliasi dengan OSS RBA, Amdalnet, KLHK, atau ATR/BPN. Keputusan
            akhir ada pada sistem OSS RBA, Amdalnet, dan instansi terkait.
          </p>
        </div>
        <div>
          <strong>Halaman</strong>
          <ul>
            <li><a href="/editor">Buat SHP</a></li>
            <li><a href="/impor">Impor & cek ZIP</a></li>
            <li><a href="/konsultan">Untuk konsultan</a></li>
            <li><a href="/layanan">Layanan konsultasi</a></li>
          </ul>
        </div>
        <div>
          <strong>Data</strong>
          <ul>
            <li>Diproses di browser</li>
            <li>Tidak dikirim ke server</li>
          </ul>
        </div>
      </div>
      <p class="note" style="text-align:center;padding:0 20px 24px;margin:0">© {year} Polify</p>
    </footer>
    <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Pemberitahuan cookie" hidden>
      <p>
        Polify memakai cookie dan penyimpanan lokal untuk fungsi dasar situs. Peta dan font dimuat dari
        pihak ketiga (OpenStreetMap dan Google Fonts). Data lahan Anda tetap diproses di browser dan tidak
        dikirim ke server kami.
      </p>
      <div class="cookie-actions">
        <button type="button" id="cookie-necessary" class="btn-ghost">Hanya yang perlu</button>
        <button type="button" id="cookie-accept">Terima semua</button>
      </div>
    </div>

    <script>
      const KEY = "polify:cookie-consent";
      const banner = document.getElementById("cookie-banner") as HTMLDivElement;

      const save = (choice: "all" | "necessary") => {
        try {
          localStorage.setItem(KEY, choice);
        } catch {
          // Penyimpanan diblokir (mode privat): banner tetap ditutup untuk sesi ini.
        }
        banner.hidden = true;
      };

      let saved: string | null = null;
      try {
        saved = localStorage.getItem(KEY);
      } catch {
        saved = null;
      }
      banner.hidden = saved !== null;

      document.getElementById("cookie-accept")!.addEventListener("click", () => save("all"));
      document.getElementById("cookie-necessary")!.addEventListener("click", () => save("necessary"));
    </script>

    <style>
      .cookie-banner {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: 12px;
        z-index: 1000;
        max-width: 720px;
        margin: 0 auto;
        padding: 16px 18px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--bg);
        box-shadow: var(--shadow-lg);
      }
      .cookie-banner[hidden] { display: none; }
      .cookie-banner p { margin: 0 0 12px; font-size: 0.92rem; color: var(--muted); }
      .cookie-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
      @media (min-width: 640px) {
        .cookie-banner { left: auto; right: 20px; bottom: 20px; margin: 0; }
      }
    </style>
  </body>
</html>
